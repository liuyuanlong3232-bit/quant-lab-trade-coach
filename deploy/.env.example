# Copy to .env on the host; never commit the copy. Blank values are intentional.
QUANT_LAB_PORT=8080
QQBOT_APP_ID_HOST_FILE=./.secrets/qqbot_app_id
QQBOT_APP_SECRET_HOST_FILE=./.secrets/qqbot_app_secret
QQBOT_OPENID_HOST_FILE=./.secrets/qqbot_openid
DEEPSEEK_API_KEY_HOST_FILE=./.secrets/deepseek_api_key
MIMO_API_KEY_HOST_FILE=./.secrets/mimo_api_key
# Optional single JSONL file path on host; leave blank unless using the risk-facts override.
QUANT_LAB_VPS_FACT_HOST_PATH=
TRADE_COACH_AI_DISCOVER_MODELS=0
